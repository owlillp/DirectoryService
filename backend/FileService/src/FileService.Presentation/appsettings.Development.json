{
  "ConnectionStrings": {
    "FileServiceDb" : "Server=localhost;Port=5434;Database=file_service_db;User Id=postgres;Password=postgres;",
    "Redis" : "localhost:6739"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Hangfire": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "FileStorageOptions":
  {
    "Endpoint": "http://localhost:9000",
    "ExternalEndpoint": "http://localhost/storage",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "WithSsl": false,
    "DownloadExpirationHours": 24,
    "UploadExpirationMinutes": 60,
    "MaxConcurrentRequests": 20,
    "RequiredBuckets": ["videos", "pictures", "documents"]
  },
  "CacheOptions": {
    "LocalCacheExpirationMinutes": 5,
    "CacheExpirationMinutes" : 30,
    "EnableRedisCache" : true
  },
  "VideoProcessing": {
    "FfmpegPath": "\"E:\\LifeTime\\Projects\\ffmpeg\\bin\\ffmpeg.exe\"",
    "FfprobePath": "\"E:\\LifeTime\\Projects\\ffmpeg\\bin\\ffprobe.exe\"",
    "UseHardwareAcceleration": false,
    "VideoEncoder": "libx264",
    "VideoPreset": "medium",
    "UploadDegreeOfParallelism": 10,
    "MaxRetries": 3,
    "RetryDelaySeconds": 3
  },
  "PreviewOptions": {
    "Quality": 2,
    "FrameWidth": 320,
    "FrameHeight": 180,
    "FileNamePattern": "preview_{index}.jpg",
    "SpriteSheetFileName": "sprite_sheet.jpg",
    "MaxPreviewCount": 10,
    "SecondsPerPreview": 10
  }
}
